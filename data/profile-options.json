{
    "download": {
        "baseUrl": "https://github.com/rumsteak08/Server/releases/download/V2/",
        "filenameTemplate": "{ram}G_{lod}_Anim{animated}_Shader{shaders}_Adv{advanced}.zip"
    },
    "ram": {
        "controlId": "ram-slider",
        "displayId": "ram-display",
        "label": "Allocated RAM",
        "description": "Choose the amount of memory Prism Launcher should allocate to this profile.",
        "default": 6,
        "values": [
            { "value": 2, "label": "2GB", "urlElement": "2" },
            { "value": 4, "label": "4GB", "urlElement": "4" },
            { "value": 6, "label": "6GB", "urlElement": "6" },
            { "value": 8, "label": "8GB", "urlElement": "8" },
            { "value": 12, "label": "12GB", "urlElement": "12" }
        ]
    },
    "options": [
        {
            "key": "lod",
            "controlId": "lod-select",
            "label": "Level of detail",
            "description": "Voxy is enabled automatically at 6GB RAM and above.",
            "minRam": 6,
            "disabledUrlElement": "No",
            "default": "Yes",
            "options": [
                { "value": "Yes", "label": "Yes, using Voxy (6GB RAM min)", "urlElement": "Voxy" }
            ]
        },
        {
            "key": "animated",
            "controlId": "animated-select",
            "label": "Animated mobs",
            "description": "Add extra mob animation features.",
            "minRam": 4,
            "disabledUrlElement": "No",
            "default": "Yes",
            "options": [
                { "value": "Yes", "label": "Yes (4GB RAM min)", "urlElement": "Yes", "minRam": 4 }
            ]
        },
        {
            "key": "shaders",
            "controlId": "shaders-select",
            "label": "Shaders",
            "description": "Shaders are enabled automatically at 6GB RAM and above.",
            "minRam": 6,
            "disabledUrlElement": "No",
            "default": "Yes",
            "options": [
                { "value": "No", "label": "No", "urlElement": "No" },
                { "value": "Yes", "label": "Yes (6GB RAM min)", "urlElement": "Yes" }
            ]
        },
        {
            "key": "advanced",
            "controlId": "adv-select",
            "label": "Advanced mods",
            "description": "This is highly dependent on what you want, so please download them separately.",
            "descriptionWhen": { "equals": "Yes" },
            "urlElement": "No",
            "default": "No",
            "options": [
                { "value": "No", "label": "No", "urlElement": "No" },
                { "value": "Yes", "label": "Yes (4GB RAM min)", "urlElement": "Yes", "minRam": 4 }
            ]
        }
    ],
    "warnings": [
        {
            "targetId": "dh-warning",
            "when": {
                "minRam": 6,
                "all": [
                    { "key": "lod", "equals": "Yes" },
                    { "key": "shaders", "equals": "Yes" }
                ]
            }
        }
    ]
}
